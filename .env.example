# ─────────────────────────────────────────────
# TripWise — Environment Variables
# Copy this to .env.local and fill in real values
# ─────────────────────────────────────────────

# ── Site URL (REQUIRED for production) ───────
# Must be your actual domain with https://
NEXT_PUBLIC_SITE_URL=https://axozen.com

# ── Supabase ──────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Admin Panel ───────────────────────────────
# Any email/password you want for /admin
ADMIN_EMAIL=admin@axozen.com
ADMIN_PASSWORD=your_secure_password_here
# Random secret for admin session cookie (generate with: openssl rand -hex 32)
ADMIN_SESSION_SECRET=your_random_secret_here

# ── Groq AI ───────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Amadeus (Flights + Hotels — optional) ─────
# Get from: https://developers.amadeus.com (free tier: 2,000 calls/month)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# ── RapidAPI / IRCTC (Trains — optional) ──────
# Get from: https://rapidapi.com/IRCTCAPI/api/irctc1 (free: 500 calls/month)
RAPIDAPI_KEY=your_rapidapi_key

# ── Affiliate IDs (optional, all have free sign-up) ────────────────────────
# Booking.com → https://www.booking.com/affiliate-program/
NEXT_PUBLIC_BOOKING_AFF_ID=
# Agoda → https://partners.agoda.com/
NEXT_PUBLIC_AGODA_AFF_ID=
# MakeMyTrip → https://www.makemytrip.com/affiliate/
NEXT_PUBLIC_MMT_AFF_ID=
# RedBus → https://www.redbus.in/affiliates/
NEXT_PUBLIC_REDBUS_AFF_ID=
# Klook → https://affiliate.klook.com/
NEXT_PUBLIC_KLOOK_AFF_ID=
# BankBazaar (travel cards) → https://www.bankbazaar.com/affiliate-program.html
NEXT_PUBLIC_BB_AFF_ID=
# Amazon Associates → https://affiliate-program.amazon.in/
NEXT_PUBLIC_AMAZON_TAG=tripwise-21
